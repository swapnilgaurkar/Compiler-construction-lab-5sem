%{
#include "y.tab.h"
%}

%%
"for"                           { return FOR; }
"int"                           { return INT; }
[a-zA-Z_][a-zA-Z0-9_]*          { return ID; }
[0-9]+                          { return NUM; }
"<="|">="|"=="|"!="|"<"|">"     { return RELOP; }
"++"                            { return INC; }
"--"                            { return DEC; }
"="                             { return '='; }
";"                             { return ';'; }
","                             { return ','; }
"("                             { return '('; }
")"                             { return ')'; }
"{"                             { return '{'; }
"}"                             { return '}'; }
[ \t\n]+                        ;
.                               { return yytext[0]; }
%%

int yywrap()
{
    return 1;
}